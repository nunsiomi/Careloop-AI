# Copy to .env and fill in. Never commit .env.

# AI models (Groq, OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Nigerian-language speech (Hausa, Yoruba, Igbo)
SPITCH_API_KEY=
# Spitch voices for Tomi; check them on the team account (voice/README.md)
SPITCH_VOICE_HA=amina
SPITCH_VOICE_YO=sade
SPITCH_VOICE_IG=ngozi
SPITCH_VOICE_EN=lucy

# Tomi voice (LiveKit Cloud: project Settings > API keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
# Twilio trial route (no SIP trunk): LiveKit SIP URI from LiveKit Settings, plus a username and
# password you make up; setup_sip.py puts them on LiveKit and Twilio sends them
LIVEKIT_SIP_URI=
LIVEKIT_SIP_USERNAME=
LIVEKIT_SIP_PASSWORD=
# 1 = the voice worker uses its built-in sample patient; 0 = it calls the backend below
VOICE_USE_MOCKS=1
# Console and Playground tests only: en, ha, yo or ig (empty = the sample patient's Hausa)
TOMI_TEST_LANGUAGE=
# Your own mobile in +234... form, so test calls to and from it act as the sample patient (PIN 1234)
VOICE_TEST_PHONE=
BACKEND_URL=http://127.0.0.1:8000/api
VOICE_SERVICE_TOKEN=

# Telnyx (python voice/setup_sip.py telnyx): your Telnyx number, and the username and password
# from the SIP connection's outbound credentials
TELNYX_PHONE_NUMBER=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=

# Phone calls (Twilio or Africa's Talking: fill in the one you use)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional fixed public address for voice/twiml_server.py; empty = it starts a Cloudflare tunnel
TWILIO_WEBHOOK_BASE=
TWILIO_PHONE_NUMBER=
AT_USERNAME=
AT_API_KEY=

# Email: the live channel for reminders and patient sign-in codes (no SMS provider yet).
# SMTP with a Gmail app password (smtp.gmail.com, 587) or Brevo (smtp-relay.brevo.com, 587).
# Leave SMTP_HOST empty, or set EMAIL_PROVIDER=console, to print emails instead of sending them.
# Railway's Hobby plan blocks SMTP ports: there, send through the Gmail API over HTTPS instead. Make a Google
# Cloud "Desktop app" OAuth client with the Gmail API on, fill in the two GMAIL_CLIENT_ values, then run
# backend/gmail_token.py once to fill in GMAIL_REFRESH_TOKEN. EMAIL_FROM must be that same Gmail address.
EMAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CareLoop <you@example.com>
RESEND_API_KEY=
# What reminder emails link to and say (generic only; never a medicine or condition)
APP_URL=
TOMI_PHONE_DISPLAY=
CARELOOP_FACILITY_NAME=
CARELOOP_TIMEZONE=Africa/Lagos

# Termii (backend/app/adapters/termii.py): text messages (sign-in codes and reminders), sign-in codes by phone
# call, and sign-in codes by email. Paid per message from the Termii wallet, not the Engage plan. API key and
# base URL are on the Termii dashboard. Empty = SMS and phone-call codes answer 503; email codes use SMTP.
TERMII_API_KEY=
TERMII_BASE_URL=
# Email sign-in codes through Termii: the ID of the email OTP config on the Termii dashboard. Its template
# sets the wording. Empty = codes go by SMTP like every other email. Reminders always go by SMTP: Termii's
# email API only accepts codes.
TERMII_EMAIL_CONFIG_ID=
# VOICE_CODE_PROVIDER=console prints phone-call codes instead of calling, for local runs.
VOICE_CODE_PROVIDER=

# SMS through Termii: SMS_PROVIDER=termii plus TERMII_API_KEY and TERMII_BASE_URL above, and a sender ID
# Termii has approved (needs CAC registration). TERMII_SMS_CHANNEL defaults to dnd, which reaches numbers on
# Nigeria's DND list at any hour; ask Termii support to switch it on. generic is for promotions only.
SMS_PROVIDER=
SMS_SENDER_ID=
TERMII_SMS_CHANNEL=

# Secrets you generate yourself, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
CODE_PEPPER=
WEBHOOK_SECRET=

# 1 = staff sign-up shows the join code of the invented sample facilities, so judges and testers can sign up.
# A real facility's code is never shown. Set 0 before real staff use the app.
CARELOOP_SHOW_JOIN_CODES=0

# Database (SQLite for local work, hosted Postgres when deployed, e.g. postgresql+psycopg://user:pass@host/db).
# An empty database is filled with the sample facility (Kestrel General) on first start.
DATABASE_URL=sqlite:///./careloop.db

# Backend switches (backend/app/main.py). Run ONE backend process: it keeps a working copy in memory.
# CARELOOP_DEMO=1 turns on /api/demo/*, the scripted voice session and simulated calls; set 0 for real patients.
CARELOOP_DEMO=1
CARELOOP_SEED=1
CARELOOP_SCHEDULER=1
# Session cookies are Secure automatically when APP_URL starts with https://; COOKIE_SECURE=1 forces it.
COOKIE_SECURE=
